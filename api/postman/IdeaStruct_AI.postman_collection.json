  "item": [
    {
      "name": "1. System Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": ["{{baseUrl}}"],
          "path": ["api", "health"]
        },
        "description": "Liveness probe and real MongoDB ping."
      },
      "response": []
    },
    {
      "name": "2. Create Project Draft",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "    var jsonData = pm.response.json();",
              "    pm.environment.set('projectId', jsonData.id);",
              "    pm.environment.set('projectRevision', jsonData.revision);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"CampusBite — Student Campus Food Ordering\",\n  \"idea\": \"A software system for university students to pre-order food from on-campus dining halls and food trucks to skip long lunch queues between classes.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/projects",
          "host": ["{{baseUrl}}"],
          "path": ["api", "projects"]
        },
        "description": "Creates a new project draft without blueprint."
      },
      "response": []
    },
    {
      "name": "3. List Projects (Paginated)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/projects?page=0&size=20",
          "host": ["{{baseUrl}}"],
          "path": ["api", "projects"],
          "query": [
            { "key": "page", "value": "0" },
            { "key": "size", "value": "20" }
          ]
        },
        "description": "Retrieves paginated list of project summaries."
      },
      "response": []
    },
    {
      "name": "4. Get Project Detail",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "    var jsonData = pm.response.json();",
              "    pm.environment.set('projectRevision', jsonData.revision);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/projects/{{projectId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "projects", "{{projectId}}"]
        },
        "description": "Fetches full project document with embedded blueprint and validation findings."
      },
      "response": []
    },
    {
      "name": "5. Update Project Title/Idea (Revision Protected)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "    var jsonData = pm.response.json();",
              "    pm.environment.set('projectRevision', jsonData.revision);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "If-Match", "value": "{{projectRevision}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"CampusBite — Updated Title\",\n  \"idea\": \"Updated idea description with more than fifty characters to fulfill the validation requirements cleanly.\",\n  \"expectedRevision\": {{projectRevision}}\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/projects/{{projectId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "projects", "{{projectId}}"]
        },
        "description": "Updates title and idea. Marks blueprintOutdated if idea has changed."
      },
      "response": []
    },
    {
      "name": "6. Generate Blueprint (DEMO Mode)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
