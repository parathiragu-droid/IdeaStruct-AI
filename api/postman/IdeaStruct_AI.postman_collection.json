        "body": {
          "mode": "raw",
          "raw": "{\n  \"mode\": \"DEMO\",\n  \"expectedRevision\": {{projectRevision}}\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/projects/{{projectId}}/generate",
          "host": ["{{baseUrl}}"],
          "path": ["api", "projects", "{{projectId}}", "generate"]
        },
        "description": "Generates initial canonical blueprint using deterministic offline fixture (source: DEMO, provider: null)."
      },
      "response": []
    },
    {
      "name": "7. Generate Blueprint (LIVE_AI Mode)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "    var jsonData = pm.response.json();",
              "    pm.environment.set('projectRevision', jsonData.revision);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"mode\": \"LIVE_AI\",\n  \"expectedRevision\": {{projectRevision}}\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/projects/{{projectId}}/generate",
          "host": ["{{baseUrl}}"],
          "path": ["api", "projects", "{{projectId}}", "generate"]
        },
        "description": "Calls configured Gemini API provider. Returns 503 if GEMINI_API_KEY is not configured on backend."
      },
      "response": []
    },
    {
      "name": "8. Update Blueprint (Manual Edit)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "    var jsonData = pm.response.json();",
              "    pm.environment.set('projectRevision', jsonData.revision);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "If-Match", "value": "{{projectRevision}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"expectedRevision\": {{projectRevision}},\n  \"blueprint\": {\n    \"schemaVersion\": \"1.0\",\n    \"overview\": {\n      \"summary\": \"Manual edit test summary with sufficient detail.\",\n      \"targetAudience\": [\"University Students\"],\n      \"coreValueProp\": \"Faster dining\",\n      \"scope\": { \"mvp\": [\"Order food\"], \"later\": [\"Delivery\"] }\n    },\n    \"features\": [],\n    \"roles\": [],\n    \"requirements\": [],\n    \"database\": {\n      \"paradigm\": \"DOCUMENT\",\n      \"collections\": [],\n      \"relationships\": []\n    },\n    \"apis\": [],\n    \"uiScreens\": [],\n    \"roadmap\": []\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/projects/{{projectId}}/blueprint",
          "host": ["{{baseUrl}}"],
          "path": ["api", "projects", "{{projectId}}", "blueprint"]
        },
        "description": "Saves manual edit with strict schema validation and optimistic revision check. Provenance becomes USER_EDITED."
      },
      "response": []
    },
    {
      "name": "9. Propose Blueprint Regeneration",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "If-Match", "value": "{{projectRevision}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"section\": \"database\",\n  \"instructions\": \"Add loyalty points collection for campus food purchases\",\n  \"expectedRevision\": {{projectRevision}}\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/projects/{{projectId}}/regenerate",
          "host": ["{{baseUrl}}"],
          "path": ["api", "projects", "{{projectId}}", "regenerate"]
        },
        "description": "Produces candidate section proposal without altering persisted project state until client applies it."
      },
      "response": []
    },
    {
      "name": "10. Deterministic Blueprint Validation",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "    var jsonData = pm.response.json();",
              "    pm.environment.set('projectRevision', jsonData.revision);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "If-Match", "value": "{{projectRevision}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"expectedRevision\": {{projectRevision}}\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/projects/{{projectId}}/validate",
          "host": ["{{baseUrl}}"],
          "path": ["api", "projects", "{{projectId}}", "validate"]
        },
        "description": "Deterministically evaluates comprehensive architectural Plan Check validation rules against saved blueprint and stores findings."
      },
      "response": []
    },
    {
      "name": "11. Delete Project (Revision Protected)",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "If-Match", "value": "{{projectRevision}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/projects/{{projectId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "projects", "{{projectId}}"]
        },
        "description": "Deletes the project aggregate from MongoDB if revision matches."
      },
      "response": []
    }
