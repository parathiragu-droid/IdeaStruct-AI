# IdeaStruct AI Environment Configuration Template
# Copy this file or set these variables in your PowerShell environment

# MongoDB Connection URI (Local default is mongodb://localhost:27017/ideastruct_ai)
MONGODB_URI=mongodb://localhost:27017/ideastruct_ai

# Gemini AI Provider Configuration (Optional for Demo mode, required for LIVE_AI)
# Never prefix with VITE_ or expose to the frontend.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Server Configuration
PORT=8080

# Production CORS & Networking
# Backend allowed origin: set to your Vercel frontend URL in production
FRONTEND_URL=https://ideastruct-ai.vercel.app

# Frontend API Base URL (used during Vite build or in frontend/.env.production)
# Set to your Railway backend URL in production
VITE_API_BASE_URL=https://ideastruct-api-production.up.railway.app
